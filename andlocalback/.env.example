PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
# Required when deployed: openssl rand -base64 32
MFA_ENCRYPTION_KEY=""
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="localads-receipts"
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_REGION=auto
# Optional security tuning (see README)
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_PER_MINUTE=600
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# Log level (fatal, error, warn, info, debug, trace, silent); default info
# LOG_LEVEL=info
# Facturación electrónica: migo | simulado | desactivado
# (sin valor: simulado en desarrollo, desactivado en producción)
# INVOICE_ISSUER=migo
# Con migo, los ids salen del catálogo de la empresa en Migo; ver README.
# Valores del catálogo de AND MARKETING DIGITAL (consultados el 2026-11-08).
# OJO: la cuenta de Migo es la real (no hay entorno de pruebas): con migo
# activado, cada factura llega al SRI.
# MIGO_BASE_URL=https://api.migo.com.ec
# MIGO_CLIENT_ID=""
# MIGO_CLIENT_SECRET=""
# MIGO_EMISSION_POINT_ID=32739
# MIGO_PRODUCT_ID_META=6644066
# MIGO_PRODUCT_CODE_META=05
# MIGO_PRODUCT_ID_GOOGLE=6644062
# MIGO_PRODUCT_CODE_GOOGLE=04
# MIGO_PRODUCT_ID_TIKTOK=6644068
# MIGO_PRODUCT_CODE_TIKTOK=06
# MIGO_VAT_TAX_ID=10
# MIGO_RUC_IDENTIFICATION_TYPE_ID=1
# MIGO_CUSTOMER_GROUP_ID=25319
# Formas de pago: Transferencia Bancaria (prepago) y Cliente (Crédito) (pospago).
# El plazo del crédito no va aquí: se elige el plazo de Migo cuyo nombre tiene
# los días del cliente («Crédito 30 días»); si no existe, hay que crearlo en Migo.
# MIGO_PREPAID_PAYMENT_METHOD_ID=6
# MIGO_CREDIT_PAYMENT_METHOD_ID=8
# Opcionales
# MIGO_VENDOR_ID=27865
# MIGO_ACTIVITY_ID=
# MIGO_TIMEOUT_MS=15000
